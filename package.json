{
  "name": "chefyeum.github.io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "chefyeum.github.io",
  "author": "ChefYeum",
  "scripts": {
    "dev": "vite",
    "develop": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && gh-pages -d dist -b static"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "marked": "^15.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "gh-pages": "^6.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
